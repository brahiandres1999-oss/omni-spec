{
  "name": "omni-spec",
  "version": "0.8.0-preview.3",
  "description": "Universal Spec-Driven Development (SDD) framework and zero-dependency CLI for agentic AI coding.",
  "type": "module",
  "main": "src/cli.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brahiandres1999-oss/omni-spec.git"
  },
  "homepage": "https://github.com/brahiandres1999-oss/omni-spec#readme",
  "bugs": {
    "url": "https://github.com/brahiandres1999-oss/omni-spec/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "preview"
  },
  "bin": {
    "omni-spec": "bin/omni-spec.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node scripts/coverage.mjs",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "node scripts/release-assets.mjs",
    "pack:dev": "node scripts/pack-dev.mjs",
    "build:skills": "node scripts/build-plugin-skills.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "assets/",
    "agents/",
    "rules/",
    "skills/",
    "plugin.json",
    "plugin.extra.json",
    "docs/ONBOARDING.md",
    "docs/STANDARDS.md",
    "docs/COMPATIBILITY.md",
    "docs/RELEASING.md",
    "docs/ROADMAP.md",
    "docs/locking.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/DELIVERY.md",
    "docs/INSTALLATION.md",
    "docs/PILOT.md"
  ],
  "keywords": [
    "spec-driven-development",
    "sdd",
    "spec-kit",
    "ai-agents",
    "agentic-coding",
    "constitution",
    "rfc",
    "bugfix-rca",
    "tech-debt"
  ],
  "author": "OmniSpec Authors",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2"
  }
}
