{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OmniSpec capability contracts",
  "description": "Explicitly recorded capability decisions. Status is declared; this registry does not infer implementation or prove compliance. Revisions retain snapshots and field deltas.",
  "type": "object",
  "required": ["schemaVersion", "revision", "contracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "revision", "effectiveRevision", "current", "history"],
        "properties": {
          "id": { "type": "string", "maxLength": 120, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "revision": { "type": "integer", "minimum": 1 },
          "effectiveRevision": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Last active/retired decision. A pending proposal preserves this revision rather than changing the effective contract."
          },
          "current": { "$ref": "#/definitions/snapshot" },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["revision", "recordedAt", "snapshot", "delta"],
              "properties": {
                "revision": { "type": "integer", "minimum": 1 },
                "recordedAt": { "type": "string", "format": "date-time" },
                "snapshot": { "$ref": "#/definitions/snapshot" },
                "delta": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "enum": ["capability", "scope", "status", "sourceSpec", "decision", "evidence"] },
                  "additionalProperties": {
                    "type": "object",
                    "required": ["from", "to"],
                    "properties": { "from": {}, "to": {} },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "snapshot": {
      "type": "object",
      "required": ["capability", "scope", "status", "sourceSpec", "decision", "evidence"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "active", "retired"] },
        "sourceSpec": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "if": { "properties": { "status": { "enum": ["active", "retired"] } } },
      "then": { "properties": { "evidence": { "minItems": 1 } } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
