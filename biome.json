{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "biome.json",
      "src/**/*.mjs",
      "test/**/*.mjs",
      "test-support/**/*.mjs",
      "scripts/**/*.mjs",
      "bin/**/*.mjs",
      "package.json",
      "plugin.json",
      "plugin.extra.json",
      "schema/**/*.json",
      "apps/studio/src/**/*.ts",
      "apps/studio/src/**/*.tsx",
      "apps/studio/e2e/**/*.ts",
      "apps/studio/tests/**/*.ts",
      "apps/studio/vite.config.ts",
      "apps/studio/scripts/**/*.mjs",
      "!schema/studio-ipc.schema.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  }
}
