{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Studio",
  "version": "0.8.1",
  "identifier": "dev.omnispec.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omni Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../bin/": "omni-spec/bin/",
      "../../../src/": "omni-spec/src/",
      "../../../schema/": "omni-spec/schema/",
      "../../../skills/": "omni-spec/skills/",
      "../../../assets/": "omni-spec/assets/",
      "../../../agents/": "omni-spec/agents/",
      "../../../rules/": "omni-spec/rules/",
      "../../../package.json": "omni-spec/package.json",
      "../../../plugin.json": "omni-spec/plugin.json",
      "../../../plugin.extra.json": "omni-spec/plugin.extra.json",
      "../../../LICENSE": "omni-spec/LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "mainBinaryName": "omni-studio"
}
