{
  "name": "omni-studio",
  "private": true,
  "version": "0.8.1",
  "description": "Omni Studio: Windows 11 desktop console for OmniSpec (Tauri v2 + React 19).",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:package": "vitest run --config tests/vitest.package.config.ts",
    "gen:ipc": "node scripts/gen-ipc-types.mjs",
    "gen:tray-icons": "node scripts/build-tray-icons.mjs",
    "bench:studio": "node scripts/bench-studio.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@git-diff-view/core": "0.1.8",
    "@git-diff-view/react": "0.1.8",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-force": "3.0.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-force": "3.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
